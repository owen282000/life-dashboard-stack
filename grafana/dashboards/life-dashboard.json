{
  "uid": "lifedashboard",
  "title": "Life Dashboard",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Steps per day",
      "type": "barchart",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "lifedash-postgres"
      },
      "targets": [
        {
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('day', ts) AS time, sum((data->>'count')::bigint) AS steps FROM records WHERE type = 'steps' AND $__timeFilter(ts) GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Heart rate",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "lifedash-postgres"
      },
      "targets": [
        {
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time, (data->>'bpm')::int AS bpm FROM records WHERE type = 'heart_rate' AND $__timeFilter(ts) ORDER BY ts",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Sleep duration per night",
      "type": "barchart",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "lifedash-postgres"
      },
      "targets": [
        {
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('day', ts) AS time, max((data->>'duration_seconds')::int) / 3600.0 AS hours FROM records WHERE type = 'sleep' AND $__timeFilter(ts) GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Weight",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "lifedash-postgres"
      },
      "targets": [
        {
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time, (data->>'kilograms')::numeric AS kg FROM records WHERE type = 'weight' AND $__timeFilter(ts) ORDER BY ts",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kg"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Screen time per day",
      "type": "barchart",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "postgres",
        "uid": "lifedash-postgres"
      },
      "targets": [
        {
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time, (data->>'total_screen_time_minutes')::int AS minutes FROM records WHERE type = 'screen_time' AND $__timeFilter(ts) ORDER BY ts",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Records received (24h)",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "postgres",
        "uid": "lifedash-postgres"
      },
      "targets": [
        {
          "format": "table",
          "rawQuery": true,
          "refId": "A",
          "rawSql": "SELECT count(*) AS records FROM records WHERE received_at > now() - interval '24 hours'"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ]
}