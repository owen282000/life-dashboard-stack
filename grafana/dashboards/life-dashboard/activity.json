        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "lifedash-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH a AS (\n  SELECT day, steps FROM dash.activity_days\n  WHERE install IN (${install:sqlstring}) AND steps IS NOT NULL\n    AND time >= $__timeFrom()::timestamptz - interval '60 days'\n    AND time <= $__timeTo()::timestamptz\n),\nr AS (\n  SELECT c.day, c.time, a.steps,\n         avg(a.steps) FILTER (WHERE c.day < dash.today()) OVER (\n           ORDER BY c.day RANGE BETWEEN interval '6 days' PRECEDING AND CURRENT ROW\n         ) AS avg7\n  FROM dash.days($__timeFrom()::timestamptz - interval '60 days',\n                 $__timeTo()::timestamptz) c\n  LEFT JOIN a USING (day)\n)\nSELECT r.time,\n       r.steps AS \"Steps\",\n       CASE WHEN r.day < dash.today() THEN round(r.avg7) END AS \"7-day average\",\n       nullif(regexp_replace(${step_goal:sqlstring}, '[^0-9.]', '', 'g'), '')::numeric AS \"Step goal\"\nFROM r\nWHERE $__timeFilter(r.time)\n  AND EXISTS (SELECT 1 FROM a WHERE a.day >= dash.local_day($__timeFrom()::timestamptz))\nORDER BY r.time",
          "refId": "A"
        }
      ],
      "title": "Steps per day",
