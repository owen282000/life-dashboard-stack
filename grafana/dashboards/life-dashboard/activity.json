      "description": "Today's step count from the phone's daily totals, counted once when a phone and a watch both record. It grows with every sync; the sparkline shows the last 30 days (dash.activity_days).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#30B77E"
          },
          "decimals": 0,
          "links": [],
          "mappings": [],
