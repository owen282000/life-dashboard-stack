          "min": 0
        },
        "exemplars": {
          "color": "rgba(255,0,255,0.7)"
        },
        "filterValues": {
          "le": 1e-09
        },
        "legend": {
          "show": true
        },
        "rowsFrame": {
          "layout": "ge",
          "value": "Steps"
        },
        "showValue": "never",
        "tooltip": {
          "mode": "single",
          "showColorScale": false,
          "yHistogram": false
        },
        "yAxis": {
          "axisPlacement": "left",
          "reverse": true,
          "unit": "none",
          "axisLabel": ""
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "lifedash-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT dash.day_start(day) AS time,\n            sum(steps) FILTER (WHERE hour = 0) AS \"00\",\nsum(steps) FILTER (WHERE hour = 1) AS \"01\",\nsum(steps) FILTER (WHERE hour = 2) AS \"02\",\nsum(steps) FILTER (WHERE hour = 3) AS \"03\",\nsum(steps) FILTER (WHERE hour = 4) AS \"04\",\nsum(steps) FILTER (WHERE hour = 5) AS \"05\",\nsum(steps) FILTER (WHERE hour = 6) AS \"06\",\nsum(steps) FILTER (WHERE hour = 7) AS \"07\",\nsum(steps) FILTER (WHERE hour = 8) AS \"08\",\nsum(steps) FILTER (WHERE hour = 9) AS \"09\",\nsum(steps) FILTER (WHERE hour = 10) AS \"10\",\nsum(steps) FILTER (WHERE hour = 11) AS \"11\",\nsum(steps) FILTER (WHERE hour = 12) AS \"12\",\nsum(steps) FILTER (WHERE hour = 13) AS \"13\",\nsum(steps) FILTER (WHERE hour = 14) AS \"14\",\nsum(steps) FILTER (WHERE hour = 15) AS \"15\",\nsum(steps) FILTER (WHERE hour = 16) AS \"16\",\nsum(steps) FILTER (WHERE hour = 17) AS \"17\",\nsum(steps) FILTER (WHERE hour = 18) AS \"18\",\nsum(steps) FILTER (WHERE hour = 19) AS \"19\",\nsum(steps) FILTER (WHERE hour = 20) AS \"20\",\nsum(steps) FILTER (WHERE hour = 21) AS \"21\",\nsum(steps) FILTER (WHERE hour = 22) AS \"22\",\nsum(steps) FILTER (WHERE hour = 23) AS \"23\"\n     FROM dash.steps_hourly\n     WHERE install IN (${install:sqlstring})\n       AND day >= dash.local_day($__timeFrom()::timestamptz)\n       AND day <= dash.local_day($__timeTo()::timestamptz)\n     GROUP BY day\n     ORDER BY 1",
          "refId": "A"
        }
      ],
