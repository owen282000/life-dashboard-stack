          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT time AS \"Start\",\n       initcap(replace(activity, '_', ' ')) AS \"Activity\",\n       round(minutes) AS \"Minutes\",\n       source_app AS \"App\"\nFROM dash.workouts\nWHERE install IN (${install:sqlstring}) AND $__timeFilter(time)\nORDER BY time DESC\nLIMIT 500",
