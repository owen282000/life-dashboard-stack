        "type": "grafana-postgresql-datasource",
        "uid": "lifedash-postgres"
      },
      "description": "Steps per hour of the day, one column per day (dash.steps_hourly). Approximate: it takes the busiest writing app per hour, so the hours don't add up to the daily total.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "scaleDistribution": {
