      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "lifedash-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT dash.day_start(date_trunc('week', day::timestamp)::date) AS time,\n       initcap(replace(activity, '_', ' ')) AS metric,\n       round(sum(minutes)) AS value\nFROM dash.workouts\nWHERE install IN (${install:sqlstring})\n  AND day >= date_trunc('week', dash.local_day($__timeFrom()::timestamptz)::timestamp)::date\n  AND day <= dash.local_day($__timeTo()::timestamptz)\nGROUP BY 1, 2\nORDER BY 1, 2",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "lifedash-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT dash.day_start(w::date) AS time, 150 AS \"WHO guideline: 150 active minutes a week\"\nFROM generate_series(\n       date_trunc('week', dash.local_day($__timeFrom()::timestamptz)::timestamp),\n       dash.local_day($__timeTo()::timestamptz)::timestamp,\n       interval '1 week') AS w\nWHERE EXISTS (\n  SELECT 1 FROM dash.workouts\n  WHERE install IN (${install:sqlstring})\n    AND day >= date_trunc('week', dash.local_day($__timeFrom()::timestamptz)::timestamp)::date\n    AND day <= dash.local_day($__timeTo()::timestamptz))\nORDER BY 1",
          "refId": "B"
        }
      ],
