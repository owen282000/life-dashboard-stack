    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "lifedash-postgres"
      },
      "description": "Recorded workout minutes per week, averaged over the complete days in the range (dash.workouts). Every workout counts, whatever its intensity.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#30B77E"
          },
          "decimals": 0,
          "links": [],
          "mappings": [],
          "noValue": "No workouts recorded yet.",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#30B77E",
                "value": null
              }
            ]
          },
          "unit": "suffix: min"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "same_as_value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "lifedash-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH r AS (\n  SELECT dash.local_day($__timeFrom()::timestamptz) AS d0,\n         least(dash.local_day($__timeTo()::timestamptz), dash.today() - 1) AS d1\n)\nSELECT coalesce(sum(w.minutes), 0) * 7.0 / (r.d1 - r.d0 + 1) AS \"Per week\"\nFROM r\nLEFT JOIN dash.workouts w\n  ON w.install IN (${install:sqlstring}) AND w.day BETWEEN r.d0 AND r.d1\nWHERE r.d1 >= r.d0\n  AND EXISTS (SELECT 1 FROM dash.workouts WHERE install IN (${install:sqlstring}))\nGROUP BY r.d0, r.d1",
          "refId": "A"
        }
      ],
      "title": "Weekly workout minutes",
      "type": "stat",
      "id": 5,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      }
    },
