    {
      "type": "bargauge",
      "title": "Top apps",
      "description": "Average minutes per day over the complete days in the time range, for the 10 apps with the most time. From `dash.screen_apps`; follows the App picker.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "lifedash-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH d AS ( SELECT count(DISTINCT day) AS days FROM dash.screen_days WHERE install IN (${install:sqlstring}) AND device IN (${device:sqlstring}) AND complete AND $__timeFilter(time) ), a AS ( SELECT app, sum(minutes) AS minutes FROM dash.screen_apps WHERE install IN (${install:sqlstring}) AND device IN (${device:sqlstring}) AND package IN (${app:sqlstring}) AND day < dash.today() AND $__timeFilter(time) GROUP BY app ) SELECT a.app, a.minutes::float8 / NULLIF(d.days, 0) AS minutes FROM a CROSS JOIN d ORDER BY a.minutes DESC, a.app LIMIT 10"
        }
