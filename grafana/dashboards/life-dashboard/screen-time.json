          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT sum(total_min) AS minutes FROM dash.screen_days WHERE install IN (${install:sqlstring}) AND device IN (${device:sqlstring}) AND day = dash.today()"
        }
