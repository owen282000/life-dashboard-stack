    {
      "type": "table",
      "title": "Apps",
      "description": "Every app in the time range: average minutes per complete day, the complete days it was used on, its share of all screen time on those days and when it was last used. From `dash.screen_apps` and `dash.screen_days`.",
      "targets": [
        {
          "refId": "A",
