  "templating": {
    "list": [
      {
        "type": "query",
        "name": "install",
        "label": "Phone",
        "description": "The /webhook/<label> a phone sends to. Screen time and sleep line up when both tabs of the Android app use the same label.",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "lifedash-postgres"
        },
        "query": {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH v AS (SELECT install AS __text, install AS __value, max(last_received) AS sort FROM dash.installs GROUP BY install) SELECT __text, __value FROM (SELECT __text, __value, sort FROM v UNION ALL SELECT '-', '-', NULL WHERE NOT EXISTS (SELECT 1 FROM v)) x ORDER BY sort DESC NULLS LAST, __text",
          "refId": "SQLVariableQueryEditor-VariableQuery"
        },
        "definition": "WITH v AS (SELECT install AS __text, install AS __value, max(last_received) AS sort FROM dash.installs GROUP BY install) SELECT __text, __value FROM (SELECT __text, __value, sort FROM v UNION ALL SELECT '-', '-', NULL WHERE NOT EXISTS (SELECT 1 FROM v)) x ORDER BY sort DESC NULLS LAST, __text",
        "regex": "/^(?!-$).*/",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": "install",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "sort": 0,
        "hide": 0,
        "skipUrlSync": false
      },
      {
        "type": "query",
        "name": "device",
        "label": "Device",
        "description": "The phone model a Screen Time payload names. One Phone label normally has one.",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "lifedash-postgres"
        },
        "query": {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH v AS (SELECT coalesce(nullif(device, ''), 'unknown') AS __text, device AS __value, max(day) AS sort FROM dash.screen_days WHERE install IN (${install:sqlstring}) GROUP BY device) SELECT __text, __value FROM (SELECT __text, __value, sort FROM v UNION ALL SELECT '-', '-', NULL WHERE NOT EXISTS (SELECT 1 FROM v)) x ORDER BY sort DESC NULLS LAST, __text",
          "refId": "SQLVariableQueryEditor-VariableQuery"
        },
        "definition": "WITH v AS (SELECT coalesce(nullif(device, ''), 'unknown') AS __text, device AS __value, max(day) AS sort FROM dash.screen_days WHERE install IN (${install:sqlstring}) GROUP BY device) SELECT __text, __value FROM (SELECT __text, __value, sort FROM v UNION ALL SELECT '-', '-', NULL WHERE NOT EXISTS (SELECT 1 FROM v)) x ORDER BY sort DESC NULLS LAST, __text",
        "regex": "/^(?!-$).*/",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": "device",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "sort": 0,
        "hide": 0,
        "skipUrlSync": false
      },
      {
        "type": "query",
        "name": "app",
        "label": "App",
        "description": "Apps with screen time in the time range, most used first. Totals and the sleep panel ignore it.",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "lifedash-postgres"
        },
        "query": {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH v AS (SELECT app AS __text, package AS __value, sum(minutes) AS sort FROM dash.screen_apps WHERE install IN (${install:sqlstring}) AND device IN (${device:sqlstring}) AND $__timeFilter(time) GROUP BY app, package) SELECT __text, __value FROM (SELECT __text, __value, sort FROM v UNION ALL SELECT '-', '-', NULL WHERE NOT EXISTS (SELECT 1 FROM v)) x ORDER BY sort DESC NULLS LAST, __text",
          "refId": "SQLVariableQueryEditor-VariableQuery"
        },
        "definition": "WITH v AS (SELECT app AS __text, package AS __value, sum(minutes) AS sort FROM dash.screen_apps WHERE install IN (${install:sqlstring}) AND device IN (${device:sqlstring}) AND $__timeFilter(time) GROUP BY app, package) SELECT __text, __value FROM (SELECT __text, __value, sort FROM v UNION ALL SELECT '-', '-', NULL WHERE NOT EXISTS (SELECT 1 FROM v)) x ORDER BY sort DESC NULLS LAST, __text",
        "regex": "/^(?!-$).*/",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": "package",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "sort": 0,
        "hide": 0,
        "skipUrlSync": false
      },
