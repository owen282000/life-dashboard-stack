          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH a AS ( SELECT time, app, sum(minutes) AS minutes FROM dash.screen_apps WHERE install IN (${install:sqlstring}) AND device IN (${device:sqlstring}) AND package IN (${app:sqlstring}) AND $__timeFilter(time) GROUP BY time, app ), top AS ( SELECT app, row_number() OVER (ORDER BY sum(minutes), app DESC) AS rank FROM a GROUP BY app ORDER BY sum(minutes) DESC, app LIMIT 12 ) SELECT a.time, a.app, a.minutes FROM a JOIN top ON top.app = a.app ORDER BY top.rank, a.time"
