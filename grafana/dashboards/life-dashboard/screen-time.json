          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH d AS ( SELECT count(DISTINCT day) AS days, sum(total_min) AS total FROM dash.screen_days WHERE install IN (${install:sqlstring}) AND device IN (${device:sqlstring}) AND complete AND $__timeFilter(time) ), a AS ( SELECT app, sum(minutes) AS minutes, count(DISTINCT day) AS days_used, max(last_used) AS last_used FROM dash.screen_apps WHERE install IN (${install:sqlstring}) AND device IN (${device:sqlstring}) AND package IN (${app:sqlstring}) AND day < dash.today() AND $__timeFilter(time) GROUP BY app ) SELECT a.app AS \"App\", a.minutes::float8 / NULLIF(d.days, 0) AS \"Per day\", a.days_used AS \"Days used\", a.minutes::float8 / NULLIF(d.total, 0) AS \"Share\", a.last_used AS \"Last used\" FROM a CROSS JOIN d ORDER BY a.minutes DESC, a.app"
