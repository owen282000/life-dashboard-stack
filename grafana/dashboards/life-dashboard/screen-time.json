      }
    },
    {
      "type": "stat",
      "title": "Last use",
      "description": "The latest time any app was used on yesterday's phone day, from `last_used` in `dash.screen_apps`. The phone's day ends at 04:00 by default, so use after midnight still counts here.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "lifedash-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT to_char(max(last_used) AT TIME ZONE dash.tz(), 'HH24:MI') AS last_use FROM dash.screen_apps WHERE install IN (${install:sqlstring}) AND device IN (${device:sqlstring}) AND day = dash.today() - 1"
        }
