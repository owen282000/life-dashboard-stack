          "rawQuery": true,
          "rawSql": "SELECT NULLIF(count(DISTINCT package), 0) AS apps FROM dash.screen_apps WHERE install IN (${install:sqlstring}) AND device IN (${device:sqlstring}) AND package IN (${app:sqlstring}) AND $__timeFilter(time)"
