    {
      "type": "timeseries",
      "title": "Last phone use before sleep",
      "description": "Minutes between the last app use of the phone day before a night and the start of that night's sleep, from `dash.screen_apps` and `dash.sleep_nights` under the same Phone. Below zero means an app was used after sleep started. The phone's day ends at 04:00 by default, and apps filtered out on the phone or used a minute or less aren't in the data. Count in the legend is the number of nights.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "lifedash-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH s AS ( SELECT install, day, max(last_used) AS last_use FROM dash.screen_apps WHERE install IN (${install:sqlstring}) AND device IN (${device:sqlstring}) AND time BETWEEN $__timeFrom()::timestamptz - interval '2 days' AND $__timeTo() GROUP BY install, day ), n AS ( SELECT install, day, time, start_time FROM dash.sleep_nights WHERE install IN (${install:sqlstring}) AND $__timeFilter(time) ) SELECT n.time, n.install AS metric, round(extract(epoch FROM n.start_time - s.last_use) / 60) AS minutes FROM n JOIN s ON s.install = n.install AND s.day = n.day - 1 WHERE s.last_use IS NOT NULL ORDER BY n.time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:min",
