    {
      "type": "heatmap",
      "title": "Apps by day",
      "description": "Minutes per app per day for the 12 apps with the most time in the range: the darker the cell, the more minutes. From `dash.screen_apps`; follows the App picker.",
      "targets": [
        {
          "refId": "A",
