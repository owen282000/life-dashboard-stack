    {
      "type": "timeseries",
      "title": "Screen time per day",
      "description": "Minutes per day for the 8 apps with the most time in the range, the rest as Other, from `dash.screen_apps`. Apps used a minute or less that day and apps filtered out on the phone aren't sent, so the stack can stay under the day's total.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "lifedash-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH a AS ( SELECT time, app, sum(minutes) AS minutes FROM dash.screen_apps WHERE install IN (${install:sqlstring}) AND device IN (${device:sqlstring}) AND package IN (${app:sqlstring}) AND $__timeFilter(time) GROUP BY time, app ), top AS ( SELECT app, row_number() OVER (ORDER BY sum(minutes) DESC, app) AS rank FROM a GROUP BY app ORDER BY sum(minutes) DESC, app LIMIT 8 ) SELECT a.time, coalesce(top.app, 'Other') AS app, sum(a.minutes) AS minutes FROM a LEFT JOIN top ON top.app = a.app GROUP BY a.time, top.app, top.rank ORDER BY coalesce(top.rank, 99), a.time"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "lifedash-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time, NULLIF(regexp_replace(${screen_goal_h:sqlstring}, '[^0-9.]', '', 'g'), '')::float8 * 60 AS \"Goal\" FROM dash.days($__timeFrom(), $__timeTo()) WHERE EXISTS (SELECT 1 FROM dash.screen_days WHERE install IN (${install:sqlstring}) AND device IN (${device:sqlstring}) AND $__timeFilter(time)) ORDER BY time"
        }
      ],
      "transformations": [
        {
          "id": "partitionByValues",
          "filter": {
            "id": "byRefId",
            "options": "A"
          },
          "options": {
            "fields": [
              "app"
            ],
            "keepFields": false,
            "naming": {
              "asLabels": true
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:min",
          "decimals": 0,
          "noValue": "No screen time yet. Add the Screen Time URL in the Android app.",
          "min": 0,
          "displayName": "${__field.labels.app}",
          "color": {
            "mode": "shades",
            "fixedColor": "#F2884B"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 85,
            "gradientMode": "none",
            "barAlignment": 0,
            "barWidthFactor": 0.7,
            "lineInterpolation": "linear",
            "showPoints": "never",
            "pointSize": 4,
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisPlacement": "auto",
            "axisLabel": "",
            "axisSoftMin": 0,
            "axisBorderShow": false,
