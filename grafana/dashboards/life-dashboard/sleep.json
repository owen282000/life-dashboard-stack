          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time,\n       deep_h AS \"Deep\",\n       light_h AS \"Light\",\n       rem_h AS \"REM\",\n       CASE WHEN NOT has_stages THEN asleep_h END AS \"Asleep, no stages\",\n       awake_h AS \"Awake\"\nFROM dash.sleep_nights\nWHERE install IN (${install:sqlstring}) AND $__timeFilter(time)\nORDER BY time",
          "refId": "A"
