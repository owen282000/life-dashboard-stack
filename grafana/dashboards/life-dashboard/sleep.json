      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "lifedash-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH n AS (\n  SELECT day, start_time, end_time\n  FROM dash.sleep_nights\n  WHERE install IN (${install:sqlstring})\n  ORDER BY day DESC\n  LIMIT 1\n),\ns AS (\n  SELECT st.start_time, st.end_time, st.stage\n  FROM dash.sleep_stages st\n  JOIN n USING (day)\n  WHERE st.install IN (${install:sqlstring}) AND st.end_time IS NOT NULL\n  UNION ALL\n  SELECT n.start_time, n.end_time, 'asleep'\n  FROM n\n  WHERE NOT EXISTS (\n    SELECT 1 FROM dash.sleep_stages st\n    WHERE st.install IN (${install:sqlstring}) AND st.day = n.day)\n),\np AS (\n  SELECT start_time AS time, stage FROM s\n  UNION ALL\n  SELECT end_time, NULL FROM s\n)\nSELECT * FROM (\n  SELECT DISTINCT ON (time) time, stage AS \"Stage\"\n  FROM p\n  ORDER BY time, stage IS NULL\n) x\nUNION ALL\n-- The panel shows its noValue text only for a frame with a time field, so an\n-- empty night is one transparent state that carries the message.\nSELECT t, st\nFROM (VALUES ($__timeFrom()::timestamptz, 'none'),\n             ($__timeTo()::timestamptz, NULL)) AS e(t, st)\nWHERE NOT EXISTS (SELECT 1 FROM s)\nORDER BY 1",
          "refId": "A"
        }
      ],
      "timeFrom": "now-1d/d+18h",
      "hideTimeOverride": true,
      "title": "Latest night by stage",
      "type": "state-timeline",
      "id": 7,
