        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "lifedash-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT c.time, nullif(regexp_replace(${sleep_goal_h:sqlstring}, '[^0-9.]', '', 'g'), '')::numeric AS \"Sleep goal\"\nFROM dash.days($__timeFrom()::timestamptz, $__timeTo()::timestamptz) c\nWHERE EXISTS (\n  SELECT 1 FROM dash.sleep_nights n\n  WHERE n.install IN (${install:sqlstring}) AND $__timeFilter(n.time))\nORDER BY c.time",
          "refId": "B"
        }
