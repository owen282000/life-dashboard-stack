          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH span AS (\n  SELECT $__timeTo()::timestamptz - $__timeFrom()::timestamptz <= interval '14 days'\n         AS hourly\n),\nhourly AS (\n  SELECT g AS time, r.bpm_min, r.bpm, r.bpm_max\n  FROM span,\n       generate_series(dash.hour_start($__timeFrom()::timestamptz),\n                       $__timeTo()::timestamptz, interval '1 hour') AS g\n  LEFT JOIN (\n    SELECT time, bpm_min, bpm, bpm_max FROM dash.heart_rate_hourly\n    WHERE install IN (${install:sqlstring}) AND $__timeFilter(time)\n  ) r ON r.time = g\n  WHERE span.hourly\n),\ndaily AS (\n  SELECT c.time, r.bpm_min, r.bpm, r.bpm_max\n  FROM span,\n       dash.days($__timeFrom()::timestamptz, $__timeTo()::timestamptz) c\n  LEFT JOIN (\n    SELECT day, bpm_min, bpm, bpm_max FROM dash.heart_days\n    WHERE install IN (${install:sqlstring})\n      AND day >= dash.local_day($__timeFrom()::timestamptz)\n      AND day <= dash.local_day($__timeTo()::timestamptz)\n  ) r ON r.day = c.day\n  WHERE NOT span.hourly\n),\nx AS (SELECT * FROM hourly UNION ALL SELECT * FROM daily)\nSELECT time, bpm_min AS \"Lowest\", bpm AS \"Average\", bpm_max AS \"Highest\"\nFROM x\nWHERE EXISTS (SELECT 1 FROM x WHERE bpm IS NOT NULL)\nORDER BY time",
          "refId": "A"
        }
