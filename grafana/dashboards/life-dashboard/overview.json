          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH a AS (\n  SELECT day, steps FROM dash.activity_days\n  WHERE install IN (${install:sqlstring}) AND $__timeFilter(time)\n)\nSELECT c.time, a.steps AS \"Steps\"\nFROM dash.days($__timeFrom()::timestamptz, $__timeTo()::timestamptz) c\nLEFT JOIN a USING (day)\nWHERE EXISTS (SELECT 1 FROM a)\nORDER BY c.time",
