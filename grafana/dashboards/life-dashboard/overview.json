    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "lifedash-postgres"
      },
      "description": "Averages for the last 7 complete days next to the 28 days before them; today is left out because it is still counting. Workouts are minutes per week, and HRV stays split by measure because RMSSD and SDNN are different numbers. Days counts the days with data in each window.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": false,
            "inspect": false
          },
          "mappings": [],
          "noValue": "Nothing to compare yet. A few days of syncs fill this.",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "none"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Metric"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 180
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last 7 days"
            },
            "properties": [
              {
                "id": "custom.align",
                "value": "right"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "28 days before"
            },
            "properties": [
              {
                "id": "custom.align",
                "value": "right"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Change"
            },
            "properties": [
              {
                "id": "custom.align",
                "value": "right"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Days"
            },
            "properties": [
              {
                "id": "custom.align",
                "value": "right"
              },
              {
                "id": "custom.width",
                "value": 95
              }
            ]
          }
        ]
      },
      "options": {
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        },
        "showHeader": true,
        "sortBy": []
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "lifedash-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH t AS (SELECT dash.today() AS today),\nm AS (\n  SELECT 1 AS ord, 'Steps per day' AS metric, 'steps' AS kind,\n         avg(steps) FILTER (WHERE day >= today - 7)::float8 AS cur,\n         avg(steps) FILTER (WHERE day < today - 7)::float8 AS base,\n         count(steps) FILTER (WHERE day >= today - 7) AS ncur,\n         count(steps) FILTER (WHERE day < today - 7) AS nbase\n  FROM dash.activity_days, t\n  WHERE install IN (${install:sqlstring}) AND day >= today - 35 AND day < today\n  UNION ALL\n  SELECT 2, 'Asleep per night', 'hours',\n         avg(asleep_h) FILTER (WHERE day >= today - 7),\n         avg(asleep_h) FILTER (WHERE day < today - 7),\n         count(asleep_h) FILTER (WHERE day >= today - 7),\n         count(asleep_h) FILTER (WHERE day < today - 7)\n  FROM dash.sleep_nights, t\n  WHERE install IN (${install:sqlstring}) AND day >= today - 35 AND day < today\n  UNION ALL\n  SELECT 3, 'Overnight low heart rate', 'bpm',\n         avg(hr_low) FILTER (WHERE day >= today - 7),\n         avg(hr_low) FILTER (WHERE day < today - 7),\n         count(hr_low) FILTER (WHERE day >= today - 7),\n         count(hr_low) FILTER (WHERE day < today - 7)\n  FROM dash.sleep_nights, t\n  WHERE install IN (${install:sqlstring}) AND day >= today - 35 AND day < today\n  UNION ALL\n  SELECT CASE measure WHEN 'rmssd' THEN 4 ELSE 5 END,\n         CASE measure WHEN 'rmssd' THEN 'HRV (RMSSD)' WHEN 'sdnn' THEN 'HRV (SDNN)'\n                      ELSE 'HRV (' || measure || ')' END,\n         'ms',\n         avg(median) FILTER (WHERE day >= today - 7),\n         avg(median) FILTER (WHERE day < today - 7),\n         count(median) FILTER (WHERE day >= today - 7),\n         count(median) FILTER (WHERE day < today - 7)\n  FROM dash.measurement_days, t\n  WHERE install IN (${install:sqlstring}) AND type = 'heart_rate_variability'\n    AND day >= today - 35 AND day < today\n  GROUP BY measure\n  UNION ALL\n  SELECT 6, 'Workouts per week', 'minutes',\n         CASE WHEN count(*) > 0 THEN coalesce(sum(minutes) FILTER (WHERE day >= today - 7), 0) END,\n         CASE WHEN count(*) > 0 THEN coalesce(sum(minutes) FILTER (WHERE day < today - 7), 0) / 4 END,\n         count(DISTINCT day) FILTER (WHERE day >= today - 7),\n         count(DISTINCT day) FILTER (WHERE day < today - 7)\n  FROM dash.workouts, t\n  WHERE install IN (${install:sqlstring}) AND day >= today - 35 AND day < today\n  UNION ALL\n  SELECT 7, 'Screen time per day', 'screen',\n         avg(total) FILTER (WHERE day >= today - 7),\n         avg(total) FILTER (WHERE day < today - 7),\n         count(total) FILTER (WHERE day >= today - 7),\n         count(total) FILTER (WHERE day < today - 7)\n  FROM (SELECT day, sum(total_min)::float8 AS total\n        FROM dash.screen_days\n        WHERE install IN (${install:sqlstring})\n        GROUP BY day) s, t\n  WHERE day >= today - 35 AND day < today\n)\nSELECT metric AS \"Metric\",\n       CASE kind\n     WHEN 'steps' THEN to_char(round(cur), 'FM999,999,990')\n     WHEN 'hours' THEN to_char(cur, 'FM990.0') || ' h'\n     WHEN 'bpm' THEN round(cur)::int || ' bpm'\n     WHEN 'ms' THEN round(cur)::int || ' ms'\n     WHEN 'minutes' THEN round(cur)::int || ' min'\n     WHEN 'screen' THEN (round(cur)::int / 60) || ' h ' || (round(cur)::int % 60) || ' min'\n   END AS \"Last 7 days\",\n       CASE kind\n     WHEN 'steps' THEN to_char(round(base), 'FM999,999,990')\n     WHEN 'hours' THEN to_char(base, 'FM990.0') || ' h'\n     WHEN 'bpm' THEN round(base)::int || ' bpm'\n     WHEN 'ms' THEN round(base)::int || ' ms'\n     WHEN 'minutes' THEN round(base)::int || ' min'\n     WHEN 'screen' THEN (round(base)::int / 60) || ' h ' || (round(base)::int % 60) || ' min'\n   END AS \"28 days before\",\n       CASE WHEN base > 0 AND cur IS NOT NULL\n            THEN CASE WHEN cur >= base THEN '+' ELSE '' END\n                 || round((cur - base) / base * 100)::int || '%'\n       END AS \"Change\",\n       ncur || '/7, ' || nbase || '/28' AS \"Days\"\nFROM m\nWHERE cur IS NOT NULL OR base IS NOT NULL\nORDER BY ord",
          "refId": "A"
        }
      ],
      "title": "Last 7 days vs the 28 before",
      "type": "table",
      "id": 7,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      }
    },
