# Copy to .env and fill in. docker compose reads .env from this folder.

# A new install (an empty database and an empty Grafana) starts only with WEBHOOK_SECRET,
# GRAFANA_PASSWORD, GRAFANA_DB_PASSWORD and DASH_DB_PASSWORD set to values of your own;
# install.sh writes all of them. A stack that already has its data starts as before.

# The HMAC signing secret, the same as in the app (Health and Screen Time tabs).
# openssl rand -hex 32
WEBHOOK_SECRET=

# Only to store unsigned payloads from anyone who can reach the receiver, without a
# secret and without a pairing code (the apps refuse one without a secret). 1 allows it.
ALLOW_UNSIGNED=0

# The address your phone reaches the receiver on, as it goes in the pairing QR code,
# such as http://192.168.1.10:8080 or https://lifedash.example.com. The receiver adds
# /webhook/<label>. Empty: no code in the log, and the /pair page uses the address you
# open it with.
PUBLIC_URL=

# The pairing block in the receiver's log at every start: QR code, link, URL and secret.
# 0 hides it.
PAIRING_LOG=1

# The pairing page at /pair. It shows the secret, so it answers only requests from your
# own network that did not come through a reverse proxy. 0 switches it off.
PAIRING_PAGE=1

# Opens /pair from anywhere, through a proxy too, as /pair?token=<this value>. At least 16
# characters. Empty: your own network only.
PAIRING_TOKEN=

# Your time zone (IANA name). Days, nights and hours in the dashboards follow it.
TZ=UTC

# Password of grafana_ro, the read-only database user Grafana connects with.
# openssl rand -hex 16
GRAFANA_DB_PASSWORD=

# Grafana's admin password (user admin). Grafana reads it only on its first start; change
# it in Grafana after that. openssl rand -hex 16
GRAFANA_PASSWORD=

# The ports on this machine. The phones reach the receiver over your network, so it listens
# on every interface. To keep Grafana or the MCP server on this machine only, give an
# address too, such as GRAFANA_PORT=127.0.0.1:3000.
RECEIVER_PORT=8080
GRAFANA_PORT=3000

# Read-only API under /api/ on the receiver's port (docs/api.md). Off while empty. Use a
# long random string, for example the output of openssl rand -hex 32.
API_TOKEN=

# The MCP server for your own AI (docs/mcp.md), started with --profile mcp. It refuses to
# start without a token: a long random string, like API_TOKEN but a different one.
MCP_TOKEN=
MCP_PORT=8090
# Set to mcp to include the MCP server in every docker compose command.
# COMPOSE_PROFILES=mcp

# Password of dash_ro, the database user the API and the MCP server read with. It can only
# read the dash views. openssl rand -hex 16
DASH_DB_PASSWORD=

# The version of the images. Empty means the version of your docker-compose.yml. Set a
# newer one, such as 1.1.0, then run: docker compose pull && docker compose up -d
# Set 1 to follow every 1.x release with docker compose pull.
LIFEDASH_VERSION=

# Set to 1 only to start with an empty database while an old Postgres 16 volume exists.
# The upgrade script (see docs/operations.md) moves the old data over instead.
IGNORE_OLD_VOLUME=0

# To build the images from a clone of the repository instead of pulling them:
# COMPOSE_FILE=docker-compose.yml:docker-compose.build.yml
